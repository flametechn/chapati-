.driver-page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #171717;
  padding: 24px 16px;
  font-family: "Noto Sans Arabic", Tahoma, Arial, sans-serif;
}

.driver-shell {
  width: min(100%, 900px);
  margin: 0 auto;
}

.driver-login {
  width: min(100%, 460px);
  margin: 8vh auto 0;
  background: #fff;
  border: 1px solid #e7e7e7;
  border-radius: 24px;
  padding: 28px;
  box-shadow: 0 16px 50px rgba(0, 0, 0, 0.08);
}

.driver-brand {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.driver-brand__icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: #111;
  font-size: 25px;
}

.driver-brand h1,
.driver-header h1,
.driver-section h2,
.driver-modal h2 {
  margin: 0;
}

.driver-brand p,
.driver-header p {
  margin: 6px 0 0;
  color: #737373;
}

.driver-form {
  display: grid;
  gap: 18px;
}

.driver-form label {
  display: grid;
  gap: 8px;
  font-weight: 700;
}

.driver-form input {
  width: 100%;
  box-sizing: border-box;
  min-height: 50px;
  border: 1px solid #dcdcdc;
  border-radius: 14px;
  padding: 0 14px;
  font: inherit;
  outline: none;
  background: #fff;
}

.driver-form input:focus {
  border-color: #111;
  box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.08);
}

.driver-primary {
  min-height: 50px;
  border: 0;
  border-radius: 14px;
  background: #111;
  color: #fff;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
  padding: 0 18px;
}

.driver-primary:hover {
  opacity: 0.92;
}

.driver-primary:disabled,
.driver-status:disabled,
.driver-refresh:disabled,
.driver-logout:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.driver-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: #fff;
  border: 1px solid #e7e7e7;
  border-radius: 22px;
  padding: 22px;
  margin-bottom: 16px;
}

.driver-eyebrow {
  display: block;
  margin-bottom: 5px;
  color: #777;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.driver-status {
  min-height: 46px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  border: 1px solid #ddd;
  border-radius: 999px;
  background: #fff;
  padding: 0 17px;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.driver-status span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #999;
}

.driver-status.is-online span {
  background: #22a447;
  box-shadow: 0 0 0 4px rgba(34, 164, 71, 0.12);
}

.driver-alert {
  border-radius: 14px;
  padding: 13px 15px;
  margin-bottom: 16px;
  font-weight: 700;
}

.driver-alert--success {
  background: #edf9f0;
  color: #176b2e;
  border: 1px solid #ccebd3;
}

.driver-alert--error {
  background: #fff1f1;
  color: #a52323;
  border: 1px solid #f0cccc;
}

.driver-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-bottom: 18px;
}

.driver-stat {
  background: #fff;
  border: 1px solid #e7e7e7;
  border-radius: 18px;
  padding: 18px;
}

.driver-stat span {
  display: block;
  color: #777;
  font-size: 13px;
  margin-bottom: 6px;
}

.driver-stat strong {
  font-size: 28px;
}

.driver-section {
  background: #fff;
  border: 1px solid #e7e7e7;
  border-radius: 22px;
  padding: 20px;
}

.driver-section__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 16px;
}

.driver-refresh {
  min-height: 42px;
  border: 1px solid #ddd;
  border-radius: 12px;
  background: #fff;
  padding: 0 14px;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.driver-orders {
  display: grid;
  gap: 12px;
}

.driver-order {
  border: 1px solid #e8e8e8;
  border-radius: 17px;
  padding: 16px;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.driver-order:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
}

.driver-order__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.driver-order__address {
  margin: 11px 0;
  color: #555;
}

.driver-order__meta {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  color: #777;
  font-size: 13px;
}

.driver-order__meta span:first-child {
  color: #111;
  font-weight: 900;
}

.driver-badge {
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

.driver-badge--assigned {
  background: #fff5df;
  color: #8a5a00;
}

.driver-badge--picked_up {
  background: #edf3ff;
  color: #2455a4;
}

.driver-badge--delivering {
  background: #eeeaff;
  color: #6044a7;
}

.driver-badge--delivered {
  background: #edf9f0;
  color: #176b2e;
}

.driver-empty {
  text-align: center;
  padding: 50px 20px;
  color: #777;
}

.driver-empty span {
  display: block;
  font-size: 40px;
  margin-bottom: 10px;
}

.driver-empty strong {
  display: block;
  color: #222;
  margin-bottom: 5px;
}

.driver-empty p {
  margin: 0;
}

.driver-logout {
  width: 100%;
  min-height: 48px;
  margin-top: 16px;
  border: 1px solid #ddd;
  border-radius: 14px;
  background: #fff;
  color: #9b2222;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.driver-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 16px;
  background: rgba(0, 0, 0, 0.48);
}

.driver-modal {
  position: relative;
  width: min(100%, 560px);
  max-height: calc(100vh - 32px);
  overflow-y: auto;
  background: #fff;
  border-radius: 24px;
  padding: 26px;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.22);
}

.driver-modal__close {
  position: absolute;
  top: 14px;
  left: 14px;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 50%;
  background: #f2f2f2;
  font-size: 26px;
  cursor: pointer;
}

.driver-detail-list {
  display: grid;
  gap: 10px;
  margin: 22px 0;
}

.driver-detail-list > div {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
}

.driver-detail-list span {
  color: #777;
}

.driver-detail-list strong {
  text-align: left;
}

.driver-items {
  margin-top: 22px;
}

.driver-items h3 {
  margin: 0 0 10px;
}

.driver-item {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px;
  background: #f7f7f7;
  border-radius: 12px;
  margin-bottom: 8px;
}

.driver-primary--large {
  width: 100%;
  margin-top: 18px;
}

.driver-complete {
  margin-top: 18px;
  border-radius: 14px;
  background: #edf9f0;
  color: #176b2e;
  padding: 14px;
  text-align: center;
  font-weight: 800;
}

.driver-loading {
  min-height: 100vh;
  display: grid;
  place-items: center;
  font-weight: 800;
}

@media (max-width: 600px) {
  .driver-page {
    padding: 12px;
  }

  .driver-login {
    margin-top: 3vh;
    padding: 20px;
    border-radius: 20px;
  }

  .driver-header {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-status {
    justify-content: center;
  }

  .driver-section {
    padding: 15px;
  }

  .driver-section__heading {
    align-items: stretch;
    flex-direction: column;
  }

  .driver-refresh {
    width: 100%;
  }

  .driver-order__top {
    align-items: flex-start;
    flex-direction: column;
  }

  .driver-order__meta {
    flex-direction: column;
  }

  .driver-modal {
    padding: 20px;
    border-radius: 20px;
  }
}

/* Scroll الصفحة كاملة */
.driver-page {
  height: 100vh;
  overflow-y: auto;
  box-sizing: border-box;
}

/* Scroll مستقل لقائمة الطلبات */
.driver-orders {
  max-height: 60vh;
  overflow-y: auto;
  padding-left: 4px;
  padding-right: 4px;
  scrollbar-width: thin;
}
