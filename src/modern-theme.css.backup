/* =========================================================
   MODERN DARK E-COMMERCE THEME
   Chapati & Melfouf
   VISUAL ONLY — NO BUSINESS LOGIC CHANGES
   ========================================================= */

:root {
  --modern-bg: #0d0d0d;
  --modern-bg-soft: #121212;
  --modern-card: #f8f9fa;
  --modern-card-soft: #ffffff;
  --modern-orange: #ff6d00;
  --modern-orange-dark: #e65100;
  --modern-gold: #ffb300;
  --modern-text: #ffffff;
  --modern-dark-text: #171717;
  --modern-muted: #8d8d8d;
  --modern-border: rgba(255,255,255,.08);
  --modern-radius: 16px;
}

/* ---------- GLOBAL ---------- */

body {
  background: var(--modern-bg) !important;
  color: var(--modern-text);
}

#root {
  background: var(--modern-bg) !important;
  min-height: 100vh;
}

/* ---------- HEADER ---------- */

.site-header {
  position: sticky !important;
  top: 0;
  z-index: 100;
  min-height: 64px;
  padding: 10px 16px !important;
  background: rgba(13,13,13,.94) !important;
  border-bottom: 1px solid var(--modern-border);
  backdrop-filter: blur(16px);
}

.site-header__name {
  color: #fff !important;
  font-weight: 900;
}

.site-header__actions {
  gap: 8px;
}

.site-header button {
  border-radius: 14px !important;
}

.site-header__cta {
  background: var(--modern-orange) !important;
  color: #fff !important;
  border: 0 !important;
  box-shadow: 0 6px 18px rgba(255,109,0,.22);
}

/* ---------- HERO ---------- */

.hero {
  min-height: auto !important;
  margin: 12px !important;
  padding: 34px 20px 42px !important;
  border-radius: 20px !important;
  overflow: hidden;
  background: #121212 !important;
}

.hero__pattern {
  opacity: .42;
  filter: saturate(1.15) contrast(1.04);
}

.hero__overlay {
  background:
    linear-gradient(
      180deg,
      rgba(18,18,18,.32),
      rgba(13,13,13,.88)
    ) !important;
}

.hero__content {
  position: relative;
  z-index: 2;
}

.hero__title {
  color: #fff !important;
  font-weight: 950 !important;
  letter-spacing: -.03em;
}

.hero__title-line--1 {
  color: #fff !important;
}

.hero__tagline {
  color: rgba(255,255,255,.78) !important;
}

.hero__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 26px !important;
  border-radius: 26px !important;
  background: var(--modern-orange) !important;
  color: #fff !important;
  border: 0 !important;
  box-shadow: 0 10px 28px rgba(255,109,0,.28);
  font-weight: 900;
}

/* ---------- MENU ---------- */

.menu {
  background: var(--modern-bg) !important;
  padding: 8px 12px 110px !important;
}

.menu-group {
  margin-bottom: 24px;
}

.menu-group__title {
  color: #fff !important;
  font-weight: 900 !important;
  margin-bottom: 12px !important;
}

.menu-group__strip {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px !important;
}

/* ---------- PRODUCT CARDS ---------- */

.story-card {
  position: relative;
  overflow: hidden;
  min-width: 0;
  background: var(--modern-card) !important;
  color: var(--modern-dark-text) !important;
  border: 0 !important;
  border-radius: var(--modern-radius) !important;
  box-shadow: 0 5px 18px rgba(0,0,0,.16) !important;
}

.story-card__body {
  color: var(--modern-dark-text) !important;
  padding: 14px !important;
}

.story-card__name {
  color: #171717 !important;
  font-weight: 950 !important;
}

.story-card__desc {
  color: #686868 !important;
}

.story-card__price {
  color: var(--modern-orange-dark) !important;
  font-size: 18px !important;
  font-weight: 950 !important;
}

.story-card__figure {
  border-radius: 14px;
  overflow: hidden;
}

.story-card__img {
  transition: transform .3s ease;
}

.story-card:hover .story-card__img {
  transform: scale(1.04);
}

.story-card__order {
  width: 100% !important;
  height: auto !important;
  min-width: 0 !important;
  border-radius: 12px !important;
  background: var(--modern-bg) !important;
  color: #fff !important;
  border: 0 !important;
  font-size: 0.9rem !important;
  padding: 11px 14px !important;
}

/* ---------- QUANTITY ---------- */

.story-card__qty button {
  border-radius: 12px !important;
  border: 1px solid #ddd !important;
  background: #fff !important;
  color: #171717 !important;
}

/* ---------- CUSTOMER POINTS ---------- */

.customer-points-card {
  margin: 12px;
  background: linear-gradient(135deg, #171717, #0d0d0d) !important;
  border: 1px solid rgba(255,179,0,.22) !important;
  border-radius: 18px !important;
  color: #fff !important;
  box-shadow: 0 10px 30px rgba(0,0,0,.25);
}

.customer-points-card__top {
  color: #fff !important;
}

.customer-points-card strong,
.customer-points-card b {
  color: var(--modern-gold) !important;
}

/* ---------- MODALS ---------- */

.product-options-backdrop,
.cart-modal-backdrop,
.driver-login-backdrop {
  background: rgba(0,0,0,.78) !important;
  backdrop-filter: blur(8px);
}

.product-options-modal,
.cart-modal,
.driver-login-modal {
  background: #151515 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.08) !important;
  border-radius: 22px !important;
  box-shadow: 0 24px 70px rgba(0,0,0,.5) !important;
}

.product-options__section h3,
.cart-modal__header,
.cart-summary__total {
  color: #fff !important;
}

.product-option {
  background: #202020 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.08) !important;
  border-radius: 14px !important;
}

.product-option--selected {
  background: rgba(255,109,0,.14) !important;
  border-color: var(--modern-orange) !important;
  color: #fff !important;
}

.product-options__confirm,
.cart-modal__checkout {
  background: var(--modern-orange) !important;
  color: #fff !important;
  border: 0 !important;
  border-radius: 25px !important;
  min-height: 50px;
  font-weight: 900;
}

/* ---------- CART ---------- */

.cart-item {
  background: #1c1c1c !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.07) !important;
  border-radius: 16px !important;
}

.cart-item__info,
.cart-item strong {
  color: #fff !important;
}

.cart-summary {
  background: #1b1b1b !important;
  border-radius: 18px !important;
}

/* ---------- CUSTOMER FORM ---------- */

.cart-customer-form input,
.cart-customer-form textarea,
.cart-customer-form select {
  background: #202020 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.1) !important;
  border-radius: 14px !important;
}

.cart-modal__gps {
  background: #202020 !important;
  color: #fff !important;
  border-radius: 14px !important;
}

/* ---------- NOTIFICATIONS ---------- */

.customer-notifications {
  background: #151515 !important;
  color: #fff !important;
  border-radius: 18px !important;
}

.customer-notification {
  background: #202020 !important;
  color: #fff !important;
  border-radius: 14px !important;
  border-color: rgba(255,255,255,.08) !important;
}

/* ---------- FOOTER ---------- */

.site-footer {
  background: #0d0d0d !important;
  color: #fff !important;
  border-top: 1px solid rgba(255,255,255,.07);
}

.site-footer__cta {
  background: var(--modern-orange) !important;
  color: #fff !important;
  border-radius: 25px !important;
}

/* ---------- MOBILE ---------- */

@media (max-width: 767px) {
  .site-header {
    padding-inline: 12px !important;
  }

  .hero {
    margin: 8px !important;
    border-radius: 18px !important;
    padding: 30px 18px 36px !important;
  }

  .menu {
    padding-inline: 10px !important;
  }

  .menu-group__strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .story-card__body {
    padding: 11px !important;
  }

  .story-card__name {
    font-size: 15px !important;
  }

  .story-card__desc {
    font-size: 12px !important;
  }
}

@media (min-width: 768px) {
  .menu-group__strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (min-width: 1100px) {
  .menu-group__strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

.site-header__icon-button {
  position: relative;
  min-height: 42px;
  min-width: 46px;
  padding: 0 10px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 12px;
  background: rgba(255,255,255,.08);
  color: inherit;
  font: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.site-header__icon-button:hover {
  background: rgba(255,255,255,.14);
}

.site-header__icon-button > span {
  font-size: 20px;
  line-height: 1;
}

.site-header__icon-button strong {
  font-size: 14px;
}

.site-header__icon-button b {
  position: absolute;
  top: -6px;
  right: -5px;
  min-width: 19px;
  height: 19px;
  padding: 0 4px;
  border-radius: 999px;
  background: #e53935;
  color: #fff;
  font-size: 11px;
  line-height: 19px;
  text-align: center;
}

@media (max-width: 700px) {
  .site-header__icon-button {
    min-width: 40px;
    padding: 0 7px;
  }

  .site-header__customer {
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

/* =========================================================
   MOBILE PRICE / AVAILABILITY FIX
   Mobile only - Desktop unchanged
   ========================================================= */

@media (max-width: 767px) {
  .story-card__price {
    display: block !important;
    position: static !important;
    width: 100% !important;
    margin: 8px 0 4px !important;
    line-height: 1.4 !important;
    text-align: center !important;
  }

  .story-card__availability {
    display: block !important;
    position: static !important;
    width: 100% !important;
    margin: 0 0 8px !important;
    line-height: 1.4 !important;
    text-align: center !important;
    white-space: nowrap !important;
  }
}


/* =========================================================
   MOBILE PRODUCT IMAGE CENTERING
   Mobile only - Desktop unchanged
   ========================================================= */

@media (max-width: 767px) {
  .story-card__figure.glow2-product {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: visible !important;
  }

  .story-card__figure.glow2-product .story-card__img {
    display: block !important;
    margin: 0 auto !important;
    object-position: center center !important;
  }
}

/* =========================================================
   MOBILE 4 PRODUCTS PER ROW
   8 PRODUCTS VISIBLE IN 2 ROWS
   Desktop unchanged
   ========================================================= */

@media (max-width: 767px) {
  .menu-group__strip {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 5px !important;
  }

  .story-card {
    border-radius: 8px !important;
    box-shadow: 0 2px 7px rgba(0,0,0,.12) !important;
  }

  .story-card__body {
    padding: 4px !important;
  }

  .story-card__figure {
    border-radius: 6px !important;
  }

  .story-card__name {
    font-size: 10px !important;
    line-height: 1.15 !important;
    margin: 3px 0 !important;
  }

  .story-card__desc {
    font-size: 8px !important;
    line-height: 1.15 !important;
    margin: 2px 0 !important;
  }

  .story-card__price {
    font-size: 11px !important;
    margin: 2px 0 !important;
    line-height: 1.15 !important;
  }

  .story-card__availability {
    font-size: 8px !important;
    margin: 1px 0 2px !important;
    line-height: 1.15 !important;
  }

  .story-card__order {
    font-size: 8px !important;
    padding: 4px 2px !important;
    min-height: 24px !important;
    border-radius: 5px !important;
  }

  .story-card__qty {
    gap: 2px !important;
    margin: 2px 0 !important;
  }

  .story-card__qty button {
    width: 21px !important;
    height: 21px !important;
    min-width: 21px !important;
    border-radius: 5px !important;
    font-size: 11px !important;
  }
}
/* =========================================================
   MOBILE PRODUCT CARD BALANCED
   4 PRODUCTS PER ROW
   Equal cards + larger images
   Desktop unchanged
   ========================================================= */

@media (max-width: 767px) {

  .menu-group__strip {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 6px !important;
    align-items: stretch !important;
  }

  .story-card {
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    min-height: 0 !important;
    border-radius: 9px !important;
    overflow: hidden !important;
  }

  .story-card__figure {
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    height: auto !important;
    min-height: 0 !important;
    border-radius: 8px 8px 0 0 !important;
    overflow: hidden !important;
  }

  .story-card__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  .story-card__body {
    display: flex !important;
    flex-direction: column !important;
    flex: 1 1 auto !important;
    padding: 5px !important;
  }

  .story-card__name {
    font-size: 10px !important;
    line-height: 1.2 !important;
    min-height: 24px !important;
    margin: 2px 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
  }

  .story-card__desc {
    font-size: 8px !important;
    line-height: 1.15 !important;
    min-height: 18px !important;
    margin: 1px 0 !important;
    text-align: center !important;
  }

  .story-card__price {
    font-size: 11px !important;
    line-height: 1.2 !important;
    min-height: 14px !important;
    margin: 2px 0 !important;
    text-align: center !important;
  }

  .story-card__availability {
    font-size: 8px !important;
    line-height: 1.2 !important;
    min-height: 12px !important;
    margin: 1px 0 3px !important;
    text-align: center !important;
  }

  .story-card__order {
    width: 100% !important;
    min-width: 0 !important;
    min-height: 25px !important;
    height: 25px !important;
    margin-top: auto !important;
    padding: 3px 2px !important;
    border-radius: 6px !important;
    font-size: 8px !important;
    line-height: 1 !important;
    white-space: nowrap !important;
  }

  .story-card__qty {
    min-height: 23px !important;
    margin: 2px 0 !important;
    gap: 2px !important;
    justify-content: center !important;
  }

  .story-card__qty button {
    width: 22px !important;
    height: 22px !important;
    min-width: 22px !important;
    padding: 0 !important;
    border-radius: 5px !important;
  }
}
/* =========================================================
   MOBILE PRODUCT CARDS - ROUNDED
   ========================================================= */

@media (max-width: 767px) {
  .story-card {
    border-radius: 16px !important;
    overflow: hidden !important;
  }

  .story-card__figure {
    border-radius: 14px 14px 0 0 !important;
    overflow: hidden !important;
  }

  .story-card__img {
    border-radius: 0 !important;
  }

  .story-card__body {
    border-radius: 0 0 14px 14px !important;
  }

  .story-card__order {
    border-radius: 12px !important;
  }

  .story-card__qty button {
    border-radius: 50% !important;
  }
}
/* =========================================================
   MOBILE - SHORTER PRODUCT CARDS
   4 PRODUCTS PER ROW
   Desktop unchanged
   ========================================================= */

@media (max-width: 767px) {

  .story-card__figure {
    aspect-ratio: 1.25 / 1 !important;
  }

  .story-card__body {
    padding: 4px !important;
  }

  .story-card__name {
    min-height: 18px !important;
    max-height: 22px !important;
    margin: 1px 0 !important;
    line-height: 1.1 !important;
    overflow: hidden !important;
  }

  .story-card__desc {
    min-height: 0 !important;
    max-height: 16px !important;
    margin: 1px 0 !important;
    line-height: 1.1 !important;
    overflow: hidden !important;
  }

  .story-card__price {
    min-height: 0 !important;
    margin: 1px 0 !important;
    line-height: 1.1 !important;
  }

  .story-card__availability {
    min-height: 0 !important;
    margin: 1px 0 2px !important;
    line-height: 1.1 !important;
  }

  .story-card__order {
    height: 22px !important;
    min-height: 22px !important;
    padding: 2px !important;
    font-size: 8px !important;
    border-radius: 7px !important;
  }

  .story-card__qty {
    min-height: 20px !important;
    margin: 1px 0 !important;
  }

  .story-card__qty button {
    width: 20px !important;
    height: 20px !important;
    min-width: 20px !important;
  }
}
/* =========================================================
   MOBILE FINAL PRODUCT CARDS
   4 PRODUCTS PER ROW - COMPACT HEIGHT
   ========================================================= */

@media (max-width: 767px) {

  .menu-group__strip {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 5px !important;
    align-items: stretch !important;
  }

  .story-card {
    display: flex !important;
    flex-direction: column !important;
    height: auto !important;
    min-height: 0 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    box-shadow: 0 2px 6px rgba(0,0,0,.12) !important;
  }

  .story-card__figure {
    width: 100% !important;
    aspect-ratio: 1.35 / 1 !important;
    height: auto !important;
    min-height: 0 !important;
    border-radius: 12px 12px 0 0 !important;
    overflow: hidden !important;
  }

  .story-card__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  .story-card__body {
    display: flex !important;
    flex-direction: column !important;
    padding: 3px !important;
    min-height: 0 !important;
  }

  .story-card__name {
    font-size: 9px !important;
    line-height: 1.1 !important;
    height: 20px !important;
    min-height: 20px !important;
    max-height: 20px !important;
    margin: 1px 0 !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    overflow: hidden !important;
  }

  .story-card__desc {
    font-size: 7px !important;
    line-height: 1.05 !important;
    height: 13px !important;
    min-height: 13px !important;
    max-height: 13px !important;
    margin: 0 !important;
    padding: 0 !important;
    text-align: center !important;
    overflow: hidden !important;
  }

  .story-card__price {
    display: block !important;
    position: static !important;
    width: 100% !important;
    font-size: 10px !important;
    line-height: 1.1 !important;
    height: 13px !important;
    min-height: 13px !important;
    margin: 1px 0 !important;
    padding: 0 !important;
    text-align: center !important;
  }

  .story-card__availability {
    display: block !important;
    position: static !important;
    width: 100% !important;
    font-size: 7px !important;
    line-height: 1.05 !important;
    height: 11px !important;
    min-height: 11px !important;
    margin: 0 !important;
    padding: 0 !important;
    text-align: center !important;
    white-space: nowrap !important;
    overflow: hidden !important;
  }

  .story-card__qty {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 2px !important;
    height: 19px !important;
    min-height: 19px !important;
    margin: 1px 0 !important;
    padding: 0 !important;
  }

  .story-card__qty button {
    width: 19px !important;
    height: 19px !important;
    min-width: 19px !important;
    min-height: 19px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    font-size: 10px !important;
  }

  .story-card__order {
    width: 100% !important;
    height: 21px !important;
    min-height: 21px !important;
    max-height: 21px !important;
    margin: 1px 0 0 !important;
    padding: 2px !important;
    border-radius: 7px !important;
    font-size: 7px !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
  }
}

/* =========================================================
   MOBILE PRODUCT CARDS - FINAL
   4 PRODUCTS PER ROW
   COMPACT CARD HEIGHT
   DESKTOP UNCHANGED
   ========================================================= */

@media (max-width: 767px) {

  .menu-group__strip {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 5px !important;
    align-items: start !important;
  }

  .story-card {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    box-shadow: 0 2px 6px rgba(0,0,0,.12) !important;
  }

  /* IMAGE */
  .story-card__figure {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    aspect-ratio: auto !important;
    height: 65px !important;
    max-height: 65px !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 10px 10px 0 0 !important;
    overflow: hidden !important;
  }

  .story-card__img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* BODY */
  .story-card__body {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    padding: 2px !important;
    margin: 0 !important;
    overflow: hidden !important;
  }

  /* NAME */
  .story-card__name {
    display: block !important;
    width: 100% !important;
    height: 16px !important;
    min-height: 16px !important;
    max-height: 16px !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 8px !important;
    line-height: 16px !important;
    text-align: center !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  /* DESCRIPTION */
  .story-card__desc {
    display: block !important;
    width: 100% !important;
    height: 11px !important;
    min-height: 11px !important;
    max-height: 11px !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 6px !important;
    line-height: 11px !important;
    text-align: center !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  /* PRICE */
  .story-card__price {
    display: block !important;
    position: static !important;
    width: 100% !important;
    height: 13px !important;
    min-height: 13px !important;
    max-height: 13px !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 9px !important;
    line-height: 13px !important;
    text-align: center !important;
  }

  /* AVAILABILITY */
  .story-card__availability {
    display: block !important;
    position: static !important;
    width: 100% !important;
    height: 10px !important;
    min-height: 10px !important;
    max-height: 10px !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 6px !important;
    line-height: 10px !important;
    text-align: center !important;
    white-space: nowrap !important;
    overflow: hidden !important;
  }

  /* QUANTITY */
  .story-card__qty {
    display: flex !important;
    width: 100% !important;
    height: 17px !important;
    min-height: 17px !important;
    max-height: 17px !important;
    margin: 1px 0 !important;
    padding: 0 !important;
    gap: 2px !important;
    justify-content: center !important;
    align-items: center !important;
  }

  .story-card__qty button {
    width: 17px !important;
    height: 17px !important;
    min-width: 17px !important;
    min-height: 17px !important;
    max-width: 17px !important;
    max-height: 17px !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 50% !important;
    font-size: 9px !important;
  }

  /* ADD TO CART */
  .story-card__order {
    display: block !important;
    width: 100% !important;
    height: 19px !important;
    min-height: 19px !important;
    max-height: 19px !important;
    margin: 1px 0 0 !important;
    padding: 0 2px !important;
    border-radius: 6px !important;
    font-size: 6px !important;
    line-height: 19px !important;
    white-space: nowrap !important;
    overflow: hidden !important;
  }
}


@media (max-width: 767px) {
  .story-card__figure.glow2-product {
    overflow: hidden !important;
    display: block !important;
  }

  .story-card__figure.glow2-product .story-card__img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    margin: 0 !important;
  }
}
