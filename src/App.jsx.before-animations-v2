            aria-hidden="true"
          ></span>

          <span>{storeConfig.hours}</span>
        </div>

        <button
          type="button"
          className="site-footer__cta"
          onClick={() => setIsCartOpen(true)}
        >
          {cart.length > 0
            ? "مراجعة الطلب"
            : "فتح السلة"}
        </button>
      </footer>

      {isCustomerLoginOpen && (
        <div
          className="customer-login-backdrop"
          role="presentation"
          onClick={() =>
            setIsCustomerLoginOpen(false)
          }
        >
          <div
            className="customer-login-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="customer-login-title"
            onClick={(event) =>
              event.stopPropagation()
            }
          >
            <div className="customer-login__header">
              <div>
                <h2 id="customer-login-title">
                  {customer
                    ? "حسابي"
                    : "تسجيل الدخول"}
                </h2>

                <p>
                  أدخل اسمك ورقم هاتفك لتسجيل الدخول.
                </p>
              </div>

              <button
                type="button"
                className="cart-modal__close"
                onClick={() =>
                  setIsCustomerLoginOpen(false)
                }
                aria-label="إغلاق"
              >
                ×
              </button>
            </div>

            <form
              onSubmit={loginCustomer}
              className="customer-login__form"
            >
              <label>
                الاسم

                <input
                  type="text"
                  value={customerNameInput}
                  onChange={(event) =>
                    setCustomerNameInput(
                      event.target.value
                    )
                  }
                  placeholder="مثال: أحمد"
                  autoComplete="name"
                />
              </label>

              <label>
                رقم الهاتف

                <input
                  type="tel"
                  inputMode="tel"
                  value={customerPhoneInput}
                  onChange={(event) =>
                    setCustomerPhoneInput(
                      event.target.value
                    )
                  }
                  placeholder="0550000000"
                  autoComplete="tel"
                />
              </label>

              {customerLoginError && (
                <small className="customer-login__error">
                  {customerLoginError}
                </small>
              )}

              <button
                type="submit"
                className="customer-login__submit"
                disabled={customerLoginLoading}
              >
                {customerLoginLoading
                  ? "جاري تسجيل الدخول..."
                  : "تسجيل الدخول"}
              </button>
            </form>

            {customer && (
              <button
                type="button"
                className="customer-login__logout"
                onClick={() => {
                  logoutCustomer();
                  setIsCustomerLoginOpen(false);
                }}
              >
                تسجيل الخروج
              </button>
            )}
          </div>
        </div>
      )}

      {cart.length > 0 && (
        <button
          type="button"
          className={`cart-floating ${cartPulse ? "cart-floating--pulse" : ""}`}
          onClick={() => setIsCartOpen(true)}
          aria-label="فتح سلة الطلب"
        >
          <span className="cart-floating__info">
            <span className="cart-floating__badge">
              {totalItems}
            </span>

            <span className="cart-floating__text">
              <strong>سلة الطلب</strong>
              <small>اضغط لمراجعة طلبك</small>
            </span>
          </span>

          <span className="cart-floating__price">
            {formatPrice(subtotal)}
          </span>
        </button>
      )}

      {selectedItem && (
        <ProductOptionsModal
          item={selectedItem}
          onClose={() => setSelectedItem(null)}
          onConfirm={addConfiguredItem}
        />
      )}

      {isCartOpen && (
        <CartModal
          cart={cart}
          customer={customer}
          onClose={() => setIsCartOpen(false)}
          onUpdateQuantity={updateQuantity}
          onRemove={removeFromCart}
          onCheckout={checkoutOrder}
        />
      )}
    </>
  );
}