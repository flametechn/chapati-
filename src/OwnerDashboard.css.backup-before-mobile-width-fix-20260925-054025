  transition:
    transform 0.28s ease,
    box-shadow 0.28s ease,
    border-color 0.28s ease;
  animation: ownerCardEnter 0.6s ease both;
}

.owner-stat::after {
  content: "";
  position: absolute;
  width: 150px;
  height: 150px;
  left: -45px;
  bottom: -95px;
  border-radius: 50%;
  background: rgba(255, 166, 0, 0.16);
  filter: blur(32px);
  pointer-events: none;
  transition: transform 0.35s ease;
}

.owner-stat:hover {
  transform: translateY(-5px);
  border-color: rgba(255, 183, 0, 0.28);
  box-shadow:
    0 20px 48px rgba(0, 0, 0, 0.32),
    0 0 28px rgba(255, 154, 0, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.owner-stat:hover::after {
  transform: scale(1.25);
}

.owner-stat span {
  position: relative;
  z-index: 1;
  color: rgba(243, 234, 216, 0.64);
  font-weight: 700;
}

.owner-stat strong {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 12px;
  font-size: clamp(1.65rem, 3vw, 2.25rem);
  color: #fff2d2;
  text-shadow: 0 0 20px rgba(255, 176, 0, 0.1);
}

.owner-section {
  position: relative;
  margin-top: 18px;
  padding: 24px;
  border: 1px solid rgba(255, 183, 0, 0.11);
  border-radius: 24px;
  background:
    linear-gradient(
      145deg,
      rgba(31, 26, 21, 0.97),
      rgba(20, 17, 14, 0.97)
    );
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.26),
    inset 0 1px 0 rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(12px);
  animation: ownerPanelEnter 0.65s ease both;
}

.owner-section__heading {
  margin-bottom: 18px;
}

.owner-section__heading h2 {
  color: #fff1d0;
  text-shadow: 0 0 18px rgba(255, 173, 0, 0.08);
}

.owner-section__summary {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.owner-section__summary span {
  padding: 8px 12px;
  border: 1px solid rgba(255, 183, 0, 0.1);
  border-radius: 999px;
  color: rgba(255, 233, 192, 0.85);
  background: rgba(255, 176, 0, 0.055);
}

/* ===== Order cards ===== */

.owner-orders {
  display: grid;
  gap: 14px;
}

.owner-order {
  position: relative;
  overflow: hidden;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.065);
  border-radius: 19px;
  background:
    linear-gradient(
      145deg,
      rgba(42, 35, 28, 0.9),
      rgba(25, 21, 17, 0.93)
    );
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
  transition:
    transform 0.24s ease,
    border-color 0.24s ease,
    box-shadow 0.24s ease;
  animation: ownerCardEnter 0.5s ease both;
}

.owner-order:hover {
  transform: translateY(-3px);
  border-color: rgba(255, 181, 0, 0.18);
  box-shadow:
    0 16px 34px rgba(0, 0, 0, 0.28),
    0 0 24px rgba(255, 153, 0, 0.055);
}

.owner-order__top {
  gap: 12px;
}

.owner-order__meta {
  gap: 8px;
}

.owner-order__meta span {
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.025);
}

/* ===== Status pills ===== */

.owner-status,
.owner-order__status,
[class*="owner-status"] {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 34px;
  padding: 6px 12px;
  border-radius: 999px;
  font-weight: 900;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
}

/* ===== Inputs / selects / textareas ===== */

.owner-page input,
.owner-page select,
.owner-page textarea {
  width: 100%;
  min-height: 46px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 13px;
  outline: none;
  color: #f3ead8;
  background:
    linear-gradient(
      145deg,
      rgba(38, 32, 26, 0.96),
      rgba(27, 23, 19, 0.96)
    );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.025),
    0 7px 18px rgba(0, 0, 0, 0.12);
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}

.owner-page input,
.owner-page textarea {
  padding: 11px 13px;
}

.owner-page select {
  padding: 0 13px;
}

.owner-page input::placeholder,
.owner-page textarea::placeholder {
  color: rgba(243, 234, 216, 0.35);
}

.owner-page input:focus,
.owner-page select:focus,
.owner-page textarea:focus {
  border-color: rgba(255, 181, 0, 0.48);
  box-shadow:
    0 0 0 4px rgba(255, 176, 0, 0.07),
    0 10px 24px rgba(0, 0, 0, 0.18);
  transform: translateY(-1px);
}

/* ===== Driver cards ===== */

.owner-driver {
  position: relative;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.065);
  border-radius: 18px;
  background:
    linear-gradient(
      145deg,
      rgba(39, 32, 25, 0.92),
      rgba(24, 20, 16, 0.96)
    );
  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.2);
  transition:
    transform 0.24s ease,
    border-color 0.24s ease,
    box-shadow 0.24s ease;
}

.owner-driver:hover {
  transform: translateY(-3px);
  border-color: rgba(255, 183, 0, 0.17);
  box-shadow:
    0 14px 34px rgba(0, 0, 0, 0.27),
    0 0 24px rgba(255, 166, 0, 0.05);
}

.owner-driver span,
.owner-driver small {
  color: rgba(243, 234, 216, 0.58);
}

/* ===== Assignment ===== */

.owner-assignment {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

.owner-assignment select {
  flex: 1;
}

.owner-assign,
.owner-assign-button {
  min-height: 46px;
  padding: 0 18px;
  border-radius: 13px;
  color: #1b150e;
  background:
    linear-gradient(
      145deg,
      #ffc247,
      #ffac00
    );
  box-shadow:
    0 10px 22px rgba(255, 165, 0, 0.17),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.owner-assign:hover,
.owner-assign-button:hover {
  color: #140f09;
  box-shadow:
    0 14px 30px rgba(255, 165, 0, 0.24),
    0 0 22px rgba(255, 176, 0, 0.12);
}

/* ===== Alerts ===== */

.owner-alert {
  margin: 15px 0;
  padding: 14px 16px;
  border-radius: 16px;
  border-width: 1px;
  border-style: solid;
  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.2);
  animation: ownerAlertIn 0.45s ease both;
}

.owner-alert--success {
  border-color: rgba(46, 204, 113, 0.22);
  background:
    linear-gradient(
      145deg,
      rgba(34, 125, 73, 0.17),
      rgba(20, 70, 42, 0.12)
    );
}

.owner-alert--error {
  border-color: rgba(255, 91, 91, 0.2);
  background:
    linear-gradient(
      145deg,
      rgba(163, 43, 43, 0.17),
      rgba(85, 24, 24, 0.1)
    );
}

/* ===== Empty / loading ===== */

.owner-empty,
.owner-loading {
  min-height: 150px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 28px;
  border: 1px dashed rgba(255, 183, 0, 0.13);
  border-radius: 18px;
  background: rgba(255, 176, 0, 0.018);
}

.owner-empty > span {
  font-size: 2rem;
  filter: drop-shadow(0 0 12px rgba(255, 176, 0, 0.18));
}

/* ===== Modal ===== */

.owner-modal-backdrop {
  background: rgba(3, 2, 1, 0.8);
  backdrop-filter: blur(10px);
  animation: ownerBackdropIn 0.25s ease both;
}

.owner-modal {
  position: relative;
  border: 1px solid rgba(255, 183, 0, 0.15);
  border-radius: 24px;
  background:
    linear-gradient(
      145deg,
      rgba(40, 33, 26, 0.98),
      rgba(19, 16, 13, 0.99)
    );
  box-shadow:
    0 30px 90px rgba(0, 0, 0, 0.55),
    0 0 50px rgba(255, 153, 0, 0.055),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
  animation: ownerModalIn 0.3s ease both;
}

.owner-modal__close {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  color: #fff0d0;
  background: rgba(255, 255, 255, 0.045);
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.owner-modal__close:hover {
  transform: rotate(4deg) scale(1.04);
  background: rgba(255, 176, 0, 0.1);
  box-shadow: 0 0 20px rgba(255, 176, 0, 0.08);
}

.owner-detail-list {
  display: grid;
  gap: 10px;
}

.owner-detail-list > div {
  padding: 13px 14px;
  border: 1px solid rgba(255, 255, 255, 0.055);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.022);
  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.owner-detail-list > div:hover {
  transform: translateX(-2px);
  border-color: rgba(255, 183, 0, 0.12);
  background: rgba(255, 176, 0, 0.035);
}

.owner-detail-list span {
  display: block;
  margin-bottom: 5px;
  color: rgba(243, 234, 216, 0.5);
  font-size: 0.86rem;
}

.owner-detail-list strong {
  color: #fff0d0;
}

.owner-items {
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.owner-items h3 {
  color: #ffd98c;
}

.owner-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 11px 12px;
  margin-top: 8px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.018);
}

.owner-item strong {
  color: #ffc247;
}

.owner-assigned-driver {
  margin-top: 16px;
  padding: 14px;
  border: 1px solid rgba(255, 183, 0, 0.12);
  border-radius: 15px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 176, 0, 0.055),
      rgba(255, 176, 0, 0.018)
    );
  box-shadow:
    0 0 25px rgba(255, 176, 0, 0.035);
}

.owner-assigned-driver span,
.owner-assigned-driver small {
  display: block;
  color: rgba(243, 234, 216, 0.54);
}

.owner-assigned-driver strong {
  display: block;
  margin: 4px 0;
  color: #ffe0a0;
}

/* ===== Availability / product controls ===== */

.owner-page button[class*="available"],
.owner-page button[class*="availability"],
.owner-page [class*="availability"] button,
.owner-page [class*="available"] button {
  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    border-color 0.22s ease,
    background 0.22s ease;
}

.owner-page button[class*="available"]:hover,
.owner-page button[class*="availability"]:hover,
.owner-page [class*="availability"] button:hover,
.owner-page [class*="available"] button:hover {
  transform: translateY(-2px);
}

/* ===== Global owner controls ===== */

.owner-page button:focus-visible,
.owner-page input:focus-visible,
.owner-page select:focus-visible,
.owner-page textarea:focus-visible {
  outline: 2px solid rgba(255, 183, 0, 0.42);
  outline-offset: 2px;
}

.owner-page button:active {
  transform: translateY(1px);
}

/* ===== Animations ===== */

@keyframes ownerPanelEnter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ownerCardEnter {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes ownerAlertIn {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ownerBackdropIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes ownerModalIn {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ===== Responsive ===== */

@media screen and (max-width: 760px) {
  .owner-header {
    padding: 18px;
    border-radius: 20px;
  }

  .owner-header__actions {
    width: 100%;
  }

  .owner-header__actions button {
    flex: 1;
  }

  .owner-section {
    padding: 18px;
    border-radius: 20px;
  }

  .owner-stat {
    min-height: 120px;
    padding: 18px;
    border-radius: 18px;
  }

  .owner-assignment {
    align-items: stretch;
    flex-direction: column;
  }

  .owner-assign,
  .owner-assign-button {
    width: 100%;
  }
}

@media screen and (max-width: 480px) {
  .owner-page {
    padding: 10px;
  }

  .owner-stats {
    grid-template-columns: 1fr;
  }

  .owner-header__actions {
    flex-direction: column;
  }

  .owner-header__actions button {
    width: 100%;
  }

  .owner-section__summary {
    width: 100%;
  }

  .owner-section__summary span {
    flex: 1;
    text-align: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  .owner-header,
  .owner-section,
  .owner-stat,
  .owner-order,
  .owner-alert,
  .owner-modal,
  .owner-modal-backdrop {
    animation: none !important;
  }

  .owner-stat,
  .owner-order,
  .owner-driver,
  .owner-primary,
  .owner-refresh,
  .owner-assign,
  .owner-assign-button,
  .owner-page button,
  .owner-page input,
  .owner-page select,
  .owner-page textarea {
    transition: none !important;
  }
}
