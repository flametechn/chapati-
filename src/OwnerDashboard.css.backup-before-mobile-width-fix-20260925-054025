}

.owner-broadcast__form {
  display: grid;
  gap: 14px;
}

.owner-broadcast__form label {
  display: grid;
  gap: 7px;
  font-weight: 800;
}

.owner-broadcast__form input,
.owner-broadcast__form textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 14px;
  border: 1px solid #ddd;
  border-radius: 12px;
  font: inherit;
  background: #fff;
}

.owner-broadcast__form textarea {
  resize: vertical;
  min-height: 120px;
}

/* Owner Dashboard tabs */
.owner-dashboard-layout {
  display: grid;
  grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
  gap: 20px;
  align-items: start;
  direction: rtl;
}

.owner-dashboard-tabs {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  position: sticky;
  top: 20px;
}

.owner-dashboard-tab {
