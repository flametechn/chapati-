/* ===== Ø§Ù„Ù‡ÙŠØ¯Ø± ===== */
.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 22px;
  background: rgba(23, 20, 15, 0.88);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid rgba(243, 234, 216, 0.08);
}

.site-header__name {
  font-family: var(--font-display);
  font-size: 1.3rem;
  color: var(--cream);
}

.site-header__cta {
  color: var(--whatsapp);
  text-decoration: none;
  font-weight: 700;
  font-size: 0.95rem;
  padding: 7px 16px;
  border: 1.5px solid var(--whatsapp);
  border-radius: 999px;
  transition: background 0.2s ease, color 0.2s ease;
}

.site-header__cta:hover {
  background: var(--whatsapp);
  color: var(--ink);
}

/* ===== Ø§Ù„Ù‡ÙŠØ±Ùˆ ===== */
.hero {
  position: relative;
  min-height: 88vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40px 24px 90px;
  overflow: hidden;
}

.hero__pattern {
  background-image: url("/videos/t%C3%A9l%C3%A9charger.webp");
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: saturate(1.1);
  z-index: 0;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
      180deg,
      rgba(23, 20, 15, 0.55) 0%,
      rgba(23, 20, 15, 0.72) 55%,
      rgba(23, 20, 15, 0.92) 100%
    ),
    radial-gradient(circle at 20% 15%, rgba(193, 67, 43, 0.25) 0, transparent 45%);
  z-index: 0;
}

.hero__content {
  position: relative;
  z-index: 1;
  max-width: 640px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22px;
}

.hero__title {
  font-size: clamp(2.6rem, 8vw, 5rem);
  color: var(--paprika);
  text-shadow: 0 4px 0 rgba(0, 0, 0, 0.2);
}

.hero__title-line {
  display: inline-block;
  opacity: 0;
  animation: rise 0.7s ease-out forwards;
  animation-delay: 0.1s;
}

.hero__tagline {
  font-size: clamp(1.05rem, 2.6vw, 1.35rem);
  color: var(--cream);
  max-width: 30ch;
  opacity: 0;
  animation: rise 0.7s ease-out forwards;
  animation-delay: 0.32s;
}

.hero__cta {
  display: inline-block;
  background: var(--whatsapp);
  color: var(--ink);
  text-decoration: none;
  font-weight: 700;
  font-size: 1.05rem;
  padding: 16px 34px;
  border-radius: 999px;
  box-shadow: var(--shadow-soft);
  opacity: 0;
  animation: rise 0.7s ease-out forwards;
  animation-delay: 0.52s;
  transition: transform 0.18s ease, background 0.18s ease;
}

.hero__cta:hover {
  background: var(--whatsapp-dark);
  transform: translateY(-2px);
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero__tear {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 42px;
  background: var(--bg);
  clip-path: polygon(
    0% 100%, 0% 40%, 4% 60%, 8% 30%, 12% 65%, 16% 35%, 20% 60%, 24% 30%,
    28% 65%, 32% 35%, 36% 60%, 40% 30%, 44% 65%, 48% 35%, 52% 60%, 56% 30%,
    60% 65%, 64% 35%, 68% 60%, 72% 30%, 76% 65%, 80% 35%, 84% 60%, 88% 30%,
    92% 65%, 96% 35%, 100% 60%, 100% 100%
  );
}

/* ===== Ø§Ù„Ù…Ù†ÙŠÙˆ ===== */
.menu {
  position: relative;
  background: var(--bg);
  padding: 10px 0 30px;
  overflow: hidden;
}

.menu-fire-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  opacity: 0.55;
  pointer-events: none;
}

.menu-fire-overlay {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(
    180deg,
    rgba(23, 20, 15, 0.75) 0%,
    rgba(23, 20, 15, 0.9) 60%,
    var(--bg) 100%
  );
  pointer-events: none;
}

.menu-group {
  position: relative;
  z-index: 1;
}

.menu-group {
  padding: 40px 0;
}

.menu-group__title {
  font-size: clamp(1.7rem, 4vw, 2.3rem);
  color: var(--mustard);
  margin-bottom: 22px;
  padding-inline: 22px;
}

/* Ø´Ø±ÙŠØ· Ø£ÙÙ‚ÙŠ Ø¨Ø§Ù„Ù…ÙˆØ¨Ø§ÙŠÙ„ (Ø³Ù†Ø§Ø¨)ØŒ ÙˆØ´Ø¨ÙƒØ© Ø¨Ø§Ù„Ø¯ÙŠØ³ÙƒØªÙˆØ¨ */
.menu-group__strip {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-snap-type: x proximity;
  padding: 6px 22px 18px;
  scrollbar-width: none;
}

.menu-group__strip::-webkit-scrollbar {
  display: none;
}

@media (min-width: 900px) {
  .menu-group__strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    max-width: 1080px;
    margin: 0 auto;
    padding: 6px 22px 18px;
    overflow: visible;
  }
}

/* ===== ÙƒØ±Øª Ø§Ù„Ù‚ØµØ© (Ù…Ø³ØªÙˆØ­Ù‰ Ù…Ù† Ø§Ù„ÙÙŠØ¯ÙŠÙˆ) ===== */
.story-card {
  --card-from: #222;
  --card-to: #444;
  position: relative;
  flex: 0 0 240px;
  scroll-snap-align: start;
  min-height: 380px;
  border-radius: 22px;
  padding: 22px 18px 26px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: hidden;
  background: linear-gradient(155deg, var(--card-from), var(--card-to));
  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
}

.story-card__glow {
  position: absolute;
  top: -40px;
  right: -40px;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.16), transparent 70%);
}

.story-card__body {
  position: relative;
  z-index: 1;
}

.story-card__name {
  color: #fff;
  font-family: var(--font-body);
  font-weight: 900;
  font-size: 1.15rem;
}

.story-card__desc {
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.85rem;
  margin-top: 6px;
  line-height: 1.5;
}

.story-card__figure {
  position: relative;
  z-index: 1;
  margin: 18px 0 14px;
  width: 148px;
  height: 148px;
}

.story-card__shadow {
  position: absolute;
  left: 50%;
  bottom: 6px;
  width: 84px;
  height: 16px;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  filter: blur(6px);
  transform: translateX(-50%);
  animation: shadow-pulse 3.2s ease-in-out infinite;
}

.story-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4);
  animation: float-bob 3.2s ease-in-out infinite;
}

@keyframes float-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes shadow-pulse {
  0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.45; }
  50% { transform: translateX(-50%) scale(0.8); opacity: 0.25; }
}

.story-card__price {
  position: relative;
  z-index: 1;
  background: #fff;
  color: var(--ink);
  font-weight: 800;
  font-size: 0.95rem;
  padding: 6px 20px;
  border-radius: 999px;
  margin-bottom: 14px;
}

.story-card__qty {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-bottom: 12px;
}

.story-card__qty button {
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 17px;
  line-height: 1;
  cursor: pointer;
}

.story-card__qty strong {
  color: #fff;
  min-width: 18px;
  text-align: center;
}

.product-options__qty {
  display: flex;
  align-items: center;
  gap: 10px;
}

.product-options__qty button {
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 9px;
  background: #f1f1f1;
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
}

.story-card__order {
  position: relative;
  z-index: 1;
  margin-top: auto;
  width: 100%;
  text-decoration: none;
  color: #fff;
  background: var(--paprika);
  font-weight: 800;
  font-size: 0.9rem;
  padding: 11px 0;
  border-radius: 12px;
  transition: transform 0.18s ease, background 0.18s ease;
}

.story-card__order:hover {
  background: var(--paprika-dark);
  transform: translateY(-2px);
}

/* ===== Ø§Ù„Ù‚ØµØ© ===== */
.story {
  background: var(--olive-dark);
  padding: 54px 24px;
  text-align: center;
}

.story__text {
  max-width: 46ch;
  margin: 0 auto;
  font-size: clamp(1.05rem, 2.4vw, 1.25rem);
  color: var(--cream);
  line-height: 1.7;
}

/* ===== Ø§Ù„ÙÙˆØªØ± ===== */
.site-footer {
  background: var(--bg);
  padding: 40px 24px 100px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  text-align: center;
}

.site-footer__info {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: center;
  color: rgba(243, 234, 216, 0.75);
  font-size: 0.95rem;
}

.site-footer__dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(243, 234, 216, 0.4);
}

.site-footer__cta {
  color: var(--whatsapp);
  text-decoration: none;
  font-weight: 700;
  border: 1.5px solid var(--whatsapp);
  padding: 10px 24px;
  border-radius: 999px;
  transition: background 0.2s ease, color 0.2s ease;
}

.site-footer__cta:hover {
  background: var(--whatsapp);
  color: var(--ink);
}

/* ===== Ø²Ø± Ø§Ù„ÙˆØ§ØªØ³Ø§Ø¨ Ø§Ù„Ø¹Ø§Ø¦Ù… (Ù„Ù„Ù…ÙˆØ¨Ø§ÙŠÙ„ Ø®Ø§ØµØ©) ===== */
.floating-cta {
  position: fixed;
  bottom: 22px;
  left: 22px;
  z-index: 30;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--whatsapp);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-soft);
  transition: transform 0.18s ease, background 0.18s ease;
}

.floating-cta:hover {
  transform: scale(1.07);
  background: var(--whatsapp-dark);
}


/* ===== Mobile animation enhancement ===== */

@keyframes mobile-card-enter {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes mobile-food-float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-9px) rotate(0.5deg);
  }
}

@keyframes mobile-shadow-breathe {
  0%, 100% {
    transform: translateX(-50%) scale(1);
    opacity: 0.42;
  }
  50% {
    transform: translateX(-50%) scale(0.78);
    opacity: 0.24;
  }
}

@media (max-width: 779px) {
  .hero__title-line {
    animation: rise 0.75s cubic-bezier(.22,.61,.36,1) forwards;
    animation-delay: 0.12s;
  }

  .hero__tagline {
    animation: rise 0.75s cubic-bezier(.22,.61,.36,1) forwards;
    animation-delay: 0.3s;
  }

  .hero__cta {
    animation: rise 0.75s cubic-bezier(.22,.61,.36,1) forwards;
    animation-delay: 0.48s;
  }

  .story-card {
    animation: mobile-card-enter 0.65s cubic-bezier(.22,.61,.36,1) both;
    will-change: transform, opacity;
  }

  .story-card:nth-child(1) {
    animation-delay: 0.08s;
  }

  .story-card:nth-child(2) {
    animation-delay: 0.16s;
  }

  .story-card:nth-child(3) {
    animation-delay: 0.24s;
  }

  .story-card:nth-child(4) {
    animation-delay: 0.32s;
  }

  .story-card:nth-child(5) {
    animation-delay: 0.4s;
  }

  .story-card__img {
    animation: mobile-food-float 3.2s ease-in-out infinite;
    will-change: transform;
  }

  .story-card__shadow {
    animation: mobile-shadow-breathe 3.2s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .story-card__order {
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .story-card__order:active {
    transform: scale(0.97);
  }

  .hero__cta:active {
    transform: scale(0.97);
  }

  .cart-floating {
    animation: mobile-card-enter 0.45s cubic-bezier(.22,.61,.36,1) both;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__title-line,
  .hero__tagline,
  .hero__cta,
  .story-card,
  .story-card__img,
  .story-card__shadow,
  .cart-floating {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

@media (min-width: 780px) {
  .floating-cta {
    display: none;
  }
}

/* =========================================================
   ?? CHAPATI FIRE AMBIENT BACKGROUND
   ========================================================= */

.fire-background {
  position: fixed;
  inset: 0;
  z-index: -10;
  overflow: hidden;
  pointer-events: none;
  background:
    radial-gradient(
      ellipse at 50% 115%,
      rgba(255, 92, 0, 0.20) 0%,
      rgba(255, 45, 0, 0.10) 25%,
      transparent 58%
    ),
    radial-gradient(
      ellipse at 15% 100%,
      rgba(255, 140, 0, 0.12) 0%,
      transparent 45%
    ),
    radial-gradient(
      ellipse at 85% 100%,
      rgba(255, 60, 0, 0.12) 0%,
      transparent 45%
    ),
    #090706;
}

/* Main atmospheric glow */
.fire-background::before {
  content: "";
  position: absolute;
  left: -15%;
  right: -15%;
  bottom: -32%;
  height: 75%;
  border-radius: 50%;
  background:
    radial-gradient(
      ellipse at center,
      rgba(255, 91, 0, 0.34) 0%,
      rgba(255, 55, 0, 0.18) 28%,
      rgba(120, 20, 0, 0.08) 52%,
      transparent 72%
    );
  filter: blur(35px);
  animation: fireBreath 4s ease-in-out infinite alternate;
}

/* Moving flame light */
.fire-background::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -18%;
  width: 80%;
  height: 62%;
  transform: translateX(-50%);
  background:
    radial-gradient(
      ellipse at 25% 90%,
      rgba(255, 125, 0, 0.25),
      transparent 35%
    ),
    radial-gradient(
      ellipse at 50% 85%,
      rgba(255, 55, 0, 0.30),
      transparent 38%
    ),
    radial-gradient(
      ellipse at 75% 90%,
      rgba(255, 145, 0, 0.20),
      transparent 35%
    );
  filter: blur(28px);
  animation: fireMove 5s ease-in-out infinite alternate;
}

/* Floating embers */
.fire-embers {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.fire-embers span {
  position: absolute;
  bottom: -20px;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #ff9a3c;
  box-shadow:
    0 0 6px #ff6a00,
    0 0 14px rgba(255, 72, 0, 0.75);
  opacity: 0;
  animation: emberRise linear infinite;
}

.fire-embers span:nth-child(1) {
  left: 8%;
  animation-duration: 5s;
  animation-delay: 0s;
}

.fire-embers span:nth-child(2) {
  left: 18%;
  animation-duration: 7s;
  animation-delay: 2s;
}

.fire-embers span:nth-child(3) {
  left: 29%;
  animation-duration: 6s;
  animation-delay: 1s;
}

.fire-embers span:nth-child(4) {
  left: 41%;
  animation-duration: 8s;
  animation-delay: 3s;
}

.fire-embers span:nth-child(5) {
  left: 52%;
  animation-duration: 5.5s;
  animation-delay: 1.5s;
}

.fire-embers span:nth-child(6) {
  left: 64%;
  animation-duration: 7.5s;
  animation-delay: 0.5s;
}

.fire-embers span:nth-child(7) {
  left: 76%;
  animation-duration: 6.5s;
  animation-delay: 2.5s;
}

.fire-embers span:nth-child(8) {
  left: 88%;
  animation-duration: 8.5s;
  animation-delay: 4s;
}

@keyframes fireBreath {
  from {
    transform: scale(0.92) translateY(10px);
    opacity: 0.65;
  }

  to {
    transform: scale(1.08) translateY(-8px);
    opacity: 1;
  }
}

@keyframes fireMove {
  0% {
    transform: translateX(-50%) scaleX(0.88);
  }

  50% {
    transform: translateX(-50%) scaleX(1.08) translateY(-12px);
  }

  100% {
    transform: translateX(-50%) scaleX(0.94) translateY(5px);
  }
}

@keyframes emberRise {
  0% {
    transform: translate3d(0, 0, 0) scale(0.4);
    opacity: 0;
  }

  10% {
    opacity: 0.9;
  }

  50% {
    transform: translate3d(25px, -35vh, 0) scale(1);
    opacity: 0.8;
  }

  100% {
    transform: translate3d(-20px, -105vh, 0) scale(0.2);
    opacity: 0;
  }
}

/* Accessibility */
@media (prefers-reduced-motion: reduce) {
  .fire-background::before,
  .fire-background::after,
  .fire-embers span {
    animation: none;
  }
}

/* --- ??????? ??????? ?? ??????? ?????? --- */
@media screen and (max-width: 768px) {
  body, #root, .container, .app-container {
    width: 100% !important;
    max-width: 100vw !important;
    padding-left: 10px !important;
    padding-right: 10px !important;
    box-sizing: border-box !important;
    overflow-x: hidden;
  }

  .grid, .row, .card-grid, .menu-grid {
    display: flex !important;
    flex-direction: column !important;
    grid-template-columns: 1fr !important;
    width: 100% !important;
  }

  img, svg, canvas {
    max-width: 100% !important;
    height: auto !important;
  }

  button, input, select {
    width: 100% !important;
    font-size: 16px !important;
  }
}





.chapati-caption {
  will-change: transform, opacity;
  transform: translate3d(0,0,0);
  backface-visibility: hidden;
  animation: chapatiCaptionLoop 4.5s linear infinite;
}

@keyframes chapatiCaptionLoop {
  0%, 100% {
    opacity: 0;
    transform: translate3d(0, 12px, 0) scale(.96);
  }

  12% {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  55% {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  82% {
    opacity: 0;
    transform: translate3d(0, -8px, 0) scale(1.02);
  }
}

/* STRONG YELLOW GLOW */
.menu-group__title {
  text-shadow:
    0 0 4px rgba(255, 255, 255, 1),
    0 0 8px rgba(255, 230, 80, 1),
    0 0 16px rgba(255, 200, 40, 1),
    0 0 30px rgba(255, 170, 0, .95),
    0 0 50px rgba(255, 130, 0, .8),
    0 0 80px rgba(255, 100, 0, .55);
  animation: strongYellowGlow 1.8s ease-in-out infinite alternate;
}

@keyframes strongYellowGlow {
  from {
    text-shadow:
      0 0 4px rgba(255, 255, 255, 1),
      0 0 8px rgba(255, 230, 80, 1),
      0 0 16px rgba(255, 200, 40, 1),
      0 0 30px rgba(255, 170, 0, .95),
      0 0 50px rgba(255, 130, 0, .8);
  }

  to {
    text-shadow:
      0 0 6px rgba(255, 255, 255, 1),
      0 0 14px rgba(255, 240, 100, 1),
      0 0 28px rgba(255, 210, 50, 1),
      0 0 45px rgba(255, 170, 0, 1),
      0 0 70px rgba(255, 120, 0, .9),
      0 0 100px rgba(255, 80, 0, .6);
  }
}


