/* =========================================================
   MODERN DARK E-COMMERCE THEME
   Chapati & Melfouf
   VISUAL ONLY — NO BUSINESS LOGIC CHANGES
   ========================================================= */

:root {
  --modern-bg: #0d0d0d;
  --modern-bg-soft: #121212;
  --modern-card: #f8f9fa;
  --modern-card-soft: #ffffff;
  --modern-orange: #ff6d00;
  --modern-orange-dark: #e65100;
  --modern-gold: #ffb300;
  --modern-text: #ffffff;
  --modern-dark-text: #171717;
  --modern-muted: #8d8d8d;
  --modern-border: rgba(255,255,255,.08);
  --modern-radius: 16px;
}

/* ---------- GLOBAL ---------- */

body {
  background: var(--modern-bg) !important;
  color: var(--modern-text);
}

#root {
  background: var(--modern-bg) !important;
  min-height: 100vh;
}

/* ---------- HEADER ---------- */

.site-header {
  position: sticky !important;
  top: 0;
  z-index: 100;
  min-height: 64px;
  padding: 10px 16px !important;
  background: rgba(13,13,13,.94) !important;
  border-bottom: 1px solid var(--modern-border);
  backdrop-filter: blur(16px);
}

.site-header__name {
  color: #fff !important;
  font-weight: 900;
}

.site-header__actions {
  gap: 8px;
}

.site-header button {
  border-radius: 14px !important;
}

.site-header__cta {
  background: var(--modern-orange) !important;
  color: #fff !important;
  border: 0 !important;
  box-shadow: 0 6px 18px rgba(255,109,0,.22);
}

/* ---------- HERO ---------- */

.hero {
  min-height: auto !important;
  margin: 12px !important;
  padding: 34px 20px 42px !important;
  border-radius: 20px !important;
  overflow: hidden;
  background: #121212 !important;
}

.hero__pattern {
  opacity: .42;
  filter: saturate(1.15) contrast(1.04);
}

.hero__overlay {
  background:
    linear-gradient(
      180deg,
      rgba(18,18,18,.32),
      rgba(13,13,13,.88)
    ) !important;
}

.hero__content {
  position: relative;
  z-index: 2;
}

.hero__title {
  color: #fff !important;
  font-weight: 950 !important;
  letter-spacing: -.03em;
}

.hero__title-line--1 {
  color: #fff !important;
}

.hero__tagline {
  color: rgba(255,255,255,.78) !important;
}

.hero__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 26px !important;
  border-radius: 26px !important;
  background: var(--modern-orange) !important;
  color: #fff !important;
  border: 0 !important;
  box-shadow: 0 10px 28px rgba(255,109,0,.28);
  font-weight: 900;
}

/* ---------- MENU ---------- */

.menu {
  background: var(--modern-bg) !important;
  padding: 8px 12px 110px !important;
}

.menu-group {
  margin-bottom: 24px;
}

.menu-group__title {
  color: #fff !important;
  font-weight: 900 !important;
  margin-bottom: 12px !important;
}

.menu-group__strip {
  display: grid !important;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px !important;
}

/* ---------- PRODUCT CARDS ---------- */

.story-card {
  position: relative;
  overflow: hidden;
  min-width: 0;
  background: var(--modern-card) !important;
  color: var(--modern-dark-text) !important;
  border: 0 !important;
  border-radius: var(--modern-radius) !important;
  box-shadow: 0 5px 18px rgba(0,0,0,.16) !important;
}

.story-card__body {
  color: var(--modern-dark-text) !important;
  padding: 14px !important;
}

.story-card__name {
  color: #171717 !important;
  font-weight: 950 !important;
}

.story-card__desc {
  color: #686868 !important;
}

.story-card__price {
  color: var(--modern-orange-dark) !important;
  font-size: 18px !important;
  font-weight: 950 !important;
}

.story-card__figure {
  border-radius: 14px;
  overflow: hidden;
}

.story-card__img {
  transition: transform .3s ease;
}

.story-card:hover .story-card__img {
  transform: scale(1.04);
}

.story-card__order {
  width: 100% !important;
  height: auto !important;
  min-width: 0 !important;
  border-radius: 12px !important;
  background: var(--modern-bg) !important;
  color: #fff !important;
  border: 0 !important;
  font-size: 0.9rem !important;
  padding: 11px 14px !important;
}

/* ---------- QUANTITY ---------- */

.story-card__qty button {
  border-radius: 12px !important;
  border: 1px solid #ddd !important;
  background: #fff !important;
  color: #171717 !important;
}

/* ---------- CUSTOMER POINTS ---------- */

.customer-points-card {
  margin: 12px;
  background: linear-gradient(135deg, #171717, #0d0d0d) !important;
  border: 1px solid rgba(255,179,0,.22) !important;
  border-radius: 18px !important;
  color: #fff !important;
  box-shadow: 0 10px 30px rgba(0,0,0,.25);
}

.customer-points-card__top {
  color: #fff !important;
}

.customer-points-card strong,
.customer-points-card b {
  color: var(--modern-gold) !important;
}

/* ---------- MODALS ---------- */

.product-options-backdrop,
.cart-modal-backdrop,
.driver-login-backdrop {
  background: rgba(0,0,0,.78) !important;
  backdrop-filter: blur(8px);
}

.product-options-modal,
.cart-modal,
.driver-login-modal {
  background: #151515 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.08) !important;
  border-radius: 22px !important;
  box-shadow: 0 24px 70px rgba(0,0,0,.5) !important;
}

.product-options__section h3,
.cart-modal__header,
.cart-summary__total {
  color: #fff !important;
}

.product-option {
  background: #202020 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.08) !important;
  border-radius: 14px !important;
}

.product-option--selected {
  background: rgba(255,109,0,.14) !important;
  border-color: var(--modern-orange) !important;
  color: #fff !important;
}

.product-options__confirm,
.cart-modal__checkout {
  background: var(--modern-orange) !important;
  color: #fff !important;
  border: 0 !important;
  border-radius: 25px !important;
  min-height: 50px;
  font-weight: 900;
}

/* ---------- CART ---------- */

.cart-item {
  background: #1c1c1c !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.07) !important;
  border-radius: 16px !important;
}

.cart-item__info,
.cart-item strong {
  color: #fff !important;
}

.cart-summary {
  background: #1b1b1b !important;
  border-radius: 18px !important;
}

/* ---------- CUSTOMER FORM ---------- */

.cart-customer-form input,
.cart-customer-form textarea,
.cart-customer-form select {
  background: #202020 !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.1) !important;
  border-radius: 14px !important;
}

.cart-modal__gps {
  background: #202020 !important;
  color: #fff !important;
  border-radius: 14px !important;
}

/* ---------- NOTIFICATIONS ---------- */

.customer-notifications {
  background: #151515 !important;
  color: #fff !important;
  border-radius: 18px !important;
}

.customer-notification {
  background: #202020 !important;
  color: #fff !important;
  border-radius: 14px !important;
  border-color: rgba(255,255,255,.08) !important;
}

/* ---------- FOOTER ---------- */

.site-footer {
  background: #0d0d0d !important;
  color: #fff !important;
  border-top: 1px solid rgba(255,255,255,.07);
}

.site-footer__cta {
  background: var(--modern-orange) !important;
  color: #fff !important;
  border-radius: 25px !important;
}

/* ---------- MOBILE ---------- */

@media (max-width: 767px) {
  .site-header {
    padding-inline: 12px !important;
  }

  .hero {
    margin: 8px !important;
    border-radius: 18px !important;
    padding: 30px 18px 36px !important;
  }

  .menu {
    padding-inline: 10px !important;
  }

  .menu-group__strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .story-card__body {
    padding: 11px !important;
  }

  .story-card__name {
    font-size: 15px !important;
  }

  .story-card__desc {
    font-size: 12px !important;
  }
}

@media (min-width: 768px) {
  .menu-group__strip {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (min-width: 1100px) {
  .menu-group__strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

.site-header__icon-button {
  position: relative;
  min-height: 42px;
  min-width: 46px;
  padding: 0 10px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 12px;
  background: rgba(255,255,255,.08);
  color: inherit;
  font: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.site-header__icon-button:hover {
  background: rgba(255,255,255,.14);
}

.site-header__icon-button > span {
  font-size: 20px;
  line-height: 1;
}

.site-header__icon-button strong {
  font-size: 14px;
}

.site-header__icon-button b {
  position: absolute;
  top: -6px;
  right: -5px;
  min-width: 19px;
  height: 19px;
  padding: 0 4px;
  border-radius: 999px;
  background: #e53935;
  color: #fff;
  font-size: 11px;
  line-height: 19px;
  text-align: center;
}

@media (max-width: 700px) {
  .site-header__icon-button {
    min-width: 40px;
    padding: 0 7px;
  }

  .site-header__customer {
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}
